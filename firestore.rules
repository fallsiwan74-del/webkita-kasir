rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GANTI dengan email akun admin Anda (sama dengan CONFIG.ADMIN_EMAIL di index.html)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "GANTI_EMAIL_ADMIN@contoh.com"
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }

    // Profil pengguna. Paket langganan & saldo komisi hanya boleh diubah admin.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.referralBalance == 0
                    && request.resource.data.referralEarned == 0;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['plan','referralBalance','referralEarned','referralCode','referredBy','createdAt']));

      // produk, penjualan, pengeluaran, notifikasi milik pengguna
      match /{sub}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow create: if isAdmin() && sub == 'notifications';   // admin mengirim notifikasi pembayaran/komisi
      }
    }

    // Kuota 30 pendaftar gratis (hanya boleh naik 1 per pendaftaran, maks 30)
    match /meta/counter {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 30;
    }

    // Kode referal -> pemilik
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /referrals/{id} {
      allow create: if signedIn()
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.status == 'terdaftar'
        && request.resource.data.commission == 0
        && request.resource.data.paidAmount == 0;
      allow read: if signedIn() && (resource.data.referrerUid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /payments/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /payouts/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
  }
}
